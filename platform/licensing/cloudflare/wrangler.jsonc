{
  "name": "resistor-licensing",
  "main": "worker.mjs",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {"bindings": [{"name": "LICENSE_AUTHORITY", "class_name": "LicenseAuthority"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["LicenseAuthority"]}],
  "observability": {"enabled": false}
}
