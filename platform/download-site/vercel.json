      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/tutorial-assets/(.*).vtt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/vtt; charset=utf-8"
        }
      ]
    },
    {
      "source": "/tutorial-assets/subtitles-ko.vtt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/vtt; charset=utf-8"
        }
      ]
    },
    {
      "source": "/tutorial-assets/guide-ko-v1.mp4",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; script-src 'self'; frame-ancestors 'none'; base-uri 'self'"
        }
      ]
    }
  ]
}
