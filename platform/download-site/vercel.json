    },
    {
      "source": "/download/macos",
      "destination": "https://github.com/Lead729726-cell/Resistor/releases/download/v0.20.0/Resistor-0.20.0-mac-arm64-r5.zip?download=1",
      "permanent": false
    },
    {
      "source": "/download/macos-intel",
      "destination": "https://github.com/Lead729726-cell/Resistor/releases/download/v0.20.0/Resistor-0.20.0-mac-x64-r5.zip?download=1",
      "permanent": false
    },
    {
