.subckt IVR_FEEDBACK OUT FB VGND
RR_BOTTOM FB VGND 200000
RR_TOP OUT FB 200000
.ends IVR_FEEDBACK
.subckt IVR_COMPENSATION EA_OUT GATE OUT
CC_COMP GATE ZERO 1e-11
RR_GATE EA_OUT GATE 1000
RR_ZERO ZERO OUT 1000
.ends IVR_COMPENSATION
.subckt IVR_ENABLE EN ENB GATE OUT VPWR VGND
XN_DISCHARGE OUT ENB VGND VGND sky130_fd_pr__nfet_01v8 w=2 l=1 nf=1 m=1
XN_INV ENB EN VGND VGND sky130_fd_pr__nfet_01v8 w=0.5 l=0.15 nf=1 m=1
XP_GATE_OFF GATE EN VPWR VPWR sky130_fd_pr__pfet_01v8_hvt w=20 l=0.15 nf=1 m=1
XP_INV ENB EN VPWR VPWR sky130_fd_pr__pfet_01v8_hvt w=1 l=0.15 nf=1 m=1
.ends IVR_ENABLE
.subckt IVR_DECOUPLING OUT VGND
