RR_ESR OUT CAP 0.5
.ends IVR_DECOUPLING
.subckt soc_ivr_ldo VREF EN OUT FB GATE BIAS VPWR VGND
XBIAS_SOURCE BIAS ENB VPWR VGND IVR_BIAS
XCOMPENSATION EA_OUT GATE OUT IVR_COMPENSATION
XDECOUPLING OUT VGND IVR_DECOUPLING
XENABLE EN ENB GATE OUT VPWR VGND IVR_ENABLE
XERROR_AMP VREF FB BIAS EA_OUT VPWR VGND IVR_ERROR_AMP
XFEEDBACK OUT FB VGND IVR_FEEDBACK
XPASS_BANK OUT GATE VPWR VGND IVR_PASS_BANK
.ends soc_ivr_ldo
