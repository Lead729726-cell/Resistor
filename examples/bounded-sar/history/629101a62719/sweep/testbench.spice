Actual SAR charge redistribution with continuous native comparator decisions
.include "/workspace/.runtime/eda/runs/f363f7d45d4f40c287a3433a660268be/supported-tt.spice"
.option scale=1e-6 method=gear
.include "/workspace/.runtime/eda/runs/f363f7d45d4f40c287a3433a660268be/analog.spice"
.temp 27.0
VGND VGND 0 0
VDD VPWR VGND 1.8
VIN VIN VGND 0.6
VREF VREF VGND 1.2
VCM VCM VGND 0.9
VBIAS BIAS VGND .9
VSAMPLE SAMPLE VGND 1.8
VB0 B0 VGND 0
VB1 B1 VGND 0
VB2 B2 VGND 0
VB3 B3 VGND 0
VB4 B4 VGND 0
VB5 B5 VGND 0
VB6 B6 VGND 0
VB7 B7 VGND 0
XU VIN VREF VCM BIAS SAMPLE TOP COMP B0 B1 B2 B3 B4 B5 B6 B7 VPWR VGND sar8_analog
.tran 2.59111111111e-08 0.004664 0 2.59111111111e-08
.control
set num_threads=1
set numdgt=17
set wr_singlescale
set wr_vecnames
save v(VIN) v(SAMPLE) v(TOP) v(COMP) v(VCM) i(VDD) i(VREF) v(B0) v(B1) v(B2) v(B3) v(B4) v(B5) v(B6) v(B7)
echo frame bit trial comp top vin decision > decisions.csv
alter VIN = 0.6
alter VSAMPLE = 1.8
alter VB0 = 0
alter VB1 = 0
alter VB2 = 0
alter VB3 = 0
alter VB4 = 0
alter VB5 = 0
alter VB6 = 0
alter VB7 = 0
let code = 0
stop when time = 2e-06
run
delete all
alter VSAMPLE = 0
let trial = code + 128
let drive = (floor(trial / 1) - 2*floor(trial / 2))*1.8
alter VB0 = $&drive
let drive = (floor(trial / 2) - 2*floor(trial / 4))*1.8
alter VB1 = $&drive
let drive = (floor(trial / 4) - 2*floor(trial / 8))*1.8
alter VB2 = $&drive
let drive = (floor(trial / 8) - 2*floor(trial / 16))*1.8
alter VB3 = $&drive
let drive = (floor(trial / 16) - 2*floor(trial / 32))*1.8
alter VB4 = $&drive
