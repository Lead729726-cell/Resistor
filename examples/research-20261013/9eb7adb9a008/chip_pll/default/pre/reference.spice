XP_LIMIT2 P2 PBIAS VPWR VPWR sky130_fd_pr__pfet_01v8_hvt w=10 l=0.5 nf=1 m=1
.ends RING_VCO
.subckt chip_pll REF CTRL OUT VPWR VGND
