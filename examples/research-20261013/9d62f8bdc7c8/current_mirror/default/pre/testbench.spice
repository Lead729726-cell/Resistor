let register_flow_3 = i(VDOUT)
wrdata current-flow.dat register_flow_0 register_flow_1 register_flow_2 register_flow_3
let register_voltage_0 = v(REF)
let register_voltage_1 = v(VGND)
let register_voltage_2 = v(OUT)
