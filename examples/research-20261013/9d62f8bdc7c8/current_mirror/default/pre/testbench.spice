wrdata waveform.dat mos_wave_0 mos_wave_1 mos_wave_2 mos_wave_3
write waveform.raw all
let register_flow_0 = i(v.xu.vregister_cf_608b00de935f2f3c)
let register_flow_1 = i(v.xu.vregister_cf_28153a61bb2a3581)
