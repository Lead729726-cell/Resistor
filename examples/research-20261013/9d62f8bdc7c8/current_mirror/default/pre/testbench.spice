Register actual native current_mirror
.include "/workspace/.runtime/eda/runs/f2ba255751e543f1a7b3c60c6c1bc34b/supported-tt.spice"
.option scale=1e-6
.include "/workspace/.runtime/eda/runs/f2ba255751e543f1a7b3c60c6c1bc34b/current-probe.spice"
.temp 27.0
VGND VGND 0 0
IREF 0 REF 0.0001
VDOUT OUT VGND 1.8
XU REF OUT VGND current_mirror
.control
save v(REF) v(OUT) i(VGND) i(VDOUT) i(v.xu.vregister_cf_608b00de935f2f3c) i(v.xu.vregister_cf_28153a61bb2a3581) v(VGND)
set num_threads=1
set noaskquit
set wr_singlescale
set wr_vecnames
op
let mos_sample_index=0
setscale mos_sample_index
let mos_wave_0 = v(REF)
let mos_wave_1 = v(OUT)
