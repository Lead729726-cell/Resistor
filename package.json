{
  "name": "register-eda",
  "version": "0.16.0",
  "private": true,
  "type": "module",
  "description": "Resistor: deterministic electronics calculators and integrated Register EDA workspace",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:calculators": "node node_modules/vite/bin/vite.js --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "audit:source": "node scripts/source-audit.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "test:core": "node --test --test-isolation=none tests/contracts.test.mjs tests/design-assistant.test.mjs tests/download-server.test.mjs tests/mac-platform.test.mjs tests/mac-build-options.test.mjs tests/desktop-diagnostics.test.mjs tests/worker-startup.test.mjs && node --import tsx --test --test-isolation=none tests/formulas/*.test.ts tests/schematic-drawing.test.ts tests/waveform-analysis.test.ts tests/signal-flow.test.ts tests/validation.test.ts tests/shortcuts.test.ts tests/run-status.test.ts packages/viewer/tests/*.test.ts",
    "dev:web": "node scripts/web.mjs",
    "build": "node scripts/appearance-assets.mjs && tsc --noEmit && vite build && node scripts/process-engine-build.mjs",
    "desktop": "electron apps/desktop/main.cjs",
    "package": "npm run build && node scripts/package.mjs",
    "worker:start": "node scripts/worker.mjs start",
    "worker:stop": "node scripts/worker.mjs stop",
    "doctor": "node scripts/worker.mjs doctor",
    "test": "node --test --test-isolation=none tests/contracts.test.mjs",
    "test:ui": "playwright test",
    "test:integration": "node scripts/integration.mjs",
    "test:viewer": "node --import tsx --test --test-isolation=none packages/viewer/tests/*.test.ts",
    "test:importer": "node --import tsx --test --test-isolation=none packages/importer/tests/*.test.ts tests/commercial/interchange.test.ts",
    "test:viewer-local": "node packages/ui/tests/standalone-viewer-smoke.mjs",
    "cloud:start": "node scripts/cloud.mjs",
    "test:cloud": "node --test --test-isolation=none tests/cloud.test.mjs",
    "test:pdk": "node tests/integration/pdk-setup.mjs",
    "test:pdk-cloud": "node --test --test-isolation=none tests/pdk-cloud.test.mjs",
    "test:pdk-backup": "node --test --test-isolation=none tests/pdk-backup.test.mjs",
    "agent:mcp": "node scripts/mcp.mjs",
    "test:mcp": "node --test --test-isolation=none tests/mcp.test.mjs",
    "cloud:prepare": "node scripts/cloud-deploy.mjs",
    "cloud:backup": "node scripts/cloud-backup.mjs",
    "backend:agent": "node scripts/commercial-agent.mjs",
    "test:backend": "node tests/integration/commercial-backend.mjs",
    "test:backend-cloud": "node --test --test-isolation=none tests/commercial-cloud.test.mjs",
    "test:interchange": "node tests/integration/interchange.mjs",
    "test:interchange-cloud": "node --test --test-isolation=none tests/interchange-cloud.test.mjs",
    "test:database": "node tests/integration/native-database.mjs",
    "database:doctor": "node scripts/native-database-check.mjs",
    "test:database-cloud": "node --test --test-isolation=none tests/native-database-cloud.test.mjs",
    "test:pvt": "node tests/integration/pvt.mjs",
    "test:design-tools": "node tests/integration/design-tools.mjs",
    "test:semiconductor-starters": "node tests/integration/semiconductor-starters.mjs",
    "test:integrated-cloud": "node --test --test-isolation=none tests/integrated-cloud.test.mjs",
    "brand:assets": "node scripts/brand-assets.mjs",
    "test:process": "node --import tsx --test --test-isolation=none tests/process.test.ts",
    "test:process-recipe": "node --import tsx --test --test-isolation=none tests/process-recipe.test.ts",
    "process:run": "node --import tsx scripts/process-run.ts",
    "test:digital-hierarchy": "node tests/integration/digital-hierarchy.mjs",
    "test:cpu-physical": "node tests/integration/cpu-physical.mjs",
    "package:installer": "npm run package && node scripts/installer.mjs",
    "package:mac": "npm run build && node scripts/package.mjs --mac",
    "test:desktop-diagnostics": "node --test --test-isolation=none tests/desktop-diagnostics.test.mjs",
    "test:validation": "node --import tsx --test --test-isolation=none tests/validation.test.ts",
    "test:formulas": "node --import tsx --test --test-isolation=none tests/formulas/*.test.ts",
    "test:waveform-analysis": "node --import tsx --test --test-isolation=none tests/waveform-analysis.test.ts",
    "test:signal-flow": "node --import tsx --test --test-isolation=none tests/signal-flow.test.ts",
    "package:mac:preview": "npm run build && node scripts/mac-preview.mjs",
    "package:mac:arm64": "npm run build && node scripts/package.mjs --mac --arm64",
    "package:mac:x64": "npm run build && node scripts/package.mjs --mac --x64",
    "test:mac:platform": "node --test --test-isolation=none tests/mac-platform.test.mjs tests/desktop-diagnostics.test.mjs && node --import tsx --test --test-isolation=none tests/shortcuts.test.ts",
    "test:mac:native": "node scripts/mac-native-qa.mjs",
    "package:mac:zip": "npm run build && node scripts/mac-zip-preview.mjs",
    "package:mac:m1-repair": "npm run build && node scripts/mac-zip-preview.mjs --arm64 --revision=5",
    "package:mac:release": "npm run build && node scripts/mac-zip-preview.mjs --revision=5",
    "download:start": "node scripts/download-share.mjs",
    "download:stop": "node scripts/download-share.mjs stop",
    "test:download": "node --test --test-isolation=none tests/download-server.test.mjs",
    "download:check-pdk-links": "node scripts/verify-pdk-links.mjs --external",
    "download:verify-pdk": "node scripts/verify-pdk-links.mjs",
    "test:editor-drawing": "node tests/integration/editor-drawing.mjs",
    "test:assistant": "node --test --test-isolation=none tests/design-assistant.test.mjs",
    "test:assistant-native": "node tests/integration/assistant-extensions.mjs",
    "assistant:settings": "node scripts/assistant-settings.mjs",
    "test:cpu16": "node tests/integration/cpu16.mjs",
    "package:linux": "npm run build && node scripts/linux-zip-preview.mjs",
    "download:site": "node scripts/download-site.mjs",
    "test:download-site": "node tests/integration/download-site.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "lucide-react": "0.577.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "ws": "8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.183.1",
    "electron": "44.5.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
