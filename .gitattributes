* text=auto
*.sh text eol=lf
*.command text eol=lf
*.py text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.v text eol=lf
*.cmd text eol=crlf
*.gds binary
*.oas binary
*.zip binary
*.png binary
*.jpg binary
*.webm binary
*.glb binary
# Native artifact checksums describe bytes, including original line endings.
examples/physical-library/** -text whitespace=-blank-at-eof
examples/physical-library/**/lvs.log -whitespace
examples/sigma-delta8/** -text whitespace=-blank-at-eof
examples/analog-soc/** -text whitespace=-blank-at-eof
examples/analog-soc/**/lvs.log -whitespace
examples/analog-soc/characterization/**/*.dat -whitespace
docs/evidence/analog-soc/** -text whitespace=cr-at-eol,-blank-at-eof
docs/evidence/sigma-delta8/** -text whitespace=-blank-at-eof
docs/evidence/sigma-delta8/**/ngspice.log -whitespace
examples/bounded-sar/** -text whitespace=-blank-at-eof
examples/bounded-sar/**/*.log -whitespace
docs/evidence/bounded-sar/** -text whitespace=cr-at-eol,-blank-at-eof
# Research manifests and pinned solver snapshots describe original byte hashes.
examples/research-20261013/** -text whitespace=cr-at-eol,-blank-at-eof
examples/research-20261013/**/*.log -whitespace
examples/research-20261013/**/*.spice -whitespace
docs/evidence/literature-update/** -text whitespace=cr-at-eol,-blank-at-eof
docs/evidence/literature-site/** -text whitespace=cr-at-eol,-blank-at-eof
# Public tutorial manifests pin exact bytes on every developer OS.
platform/download-site/learning* -text
platform/download-site/learning/** -text
platform/download-site/learning-assets/** -text
platform/download-site/tutorial-library.html -text
scripts/tutorial-library/*.js text eol=lf
scripts/tutorial-library/*.css text eol=lf
