{
  "schema_version": 1,
  "id": "icc2-site-v1",
  "name": "IC Compiler II — operator site validation required",
  "tool_id": "icc2",
  "version": "ICC2 site Tcl entry; installed manual required",
  "runner": {
    "kind": "local",
    "executable": "/opt/vendor/bin/icc2_shell",
    "env_names": [
      "SNPSLMD_LICENSE_FILE"
    ],
    "resources": {
      "site_script": "/workspace/site/icc2.tcl"
    },
    "recipes": {
      "implementation": {
        "argv": [
          "-f",
          "{input.site_tcl}"
        ],
        "outputs": {
          "exchange": "export.gds",
          "summary": "implementation-summary.txt"
        },
        "timeout_s": 600,
        "parameters": {},
        "result_context": {
          "formats": {
            "summary": "unsupported-site-format"
          }
        },
        "requires_netlist": false
      },
      "layout_export": {
        "argv": [
          "-f",
          "{input.site_tcl}"
        ],
        "outputs": {
          "exchange": "export.gds"
        },
        "timeout_s": 600,
        "parameters": {},
        "result_context": {
          "formats": {}
        },
        "requires_netlist": false
      },
      "netlist_export": {
        "argv": [
          "-f",
          "{input.site_tcl}"
        ],
        "outputs": {
          "netlist": "export.spice"
        },
        "timeout_s": 600,
        "parameters": {},
        "result_context": {
          "formats": {}
        },
        "requires_netlist": false
      }
    }
  }
}
