{
  "schema_version": 1,
  "id": "assura-site-v1",
  "name": "Assura — operator site validation required",
  "tool_id": "assura",
  "version": "Assura4.1 RSF site flow",
  "runner": {
    "kind": "local",
    "executable": "/opt/vendor/bin/assura",
    "env_names": [
      "CDS_LIC_FILE"
    ],
    "resources": {
      "deck": "/workspace/site/assura.runset"
    },
    "recipes": {
      "drc": {
        "argv": [
          "{resource.deck}"
        ],
        "outputs": {
          "summary": "drc-summary.txt"
        },
        "timeout_s": 600,
        "parameters": {},
        "result_context": {
          "formats": {
            "summary": "unsupported-site-format"
          }
        },
        "requires_netlist": false
      },
      "lvs": {
        "argv": [
          "{resource.deck}"
        ],
        "outputs": {
          "summary": "lvs-summary.txt"
        },
        "timeout_s": 600,
        "parameters": {},
        "result_context": {
          "formats": {
            "summary": "unsupported-site-format"
          }
        },
        "requires_netlist": true
      },
      "pex": {
        "argv": [
          "{resource.deck}"
        ],
        "outputs": {
          "rc": "parasitics.spef"
        },
        "timeout_s": 600,
        "parameters": {},
        "result_context": {
          "formats": {
            "rc": "spef"
          }
        },
        "requires_netlist": false
      }
    }
  }
}
